---
import ShopLayout from '../../layouts/ShopLayout.astro';
---

<ShopLayout title="Καλάθι — Κερί & Πηλός" active="cart">
  <div class="shop-wrap">
    <div class="shop-head" style="padding-top:40px">
      <h1 style="font-size:2rem">Το καλάθι σου</h1>
    </div>

    <div class="cart-layout">
      <div>
        <div class="cart-list" id="cart-list">
          <p class="shop-loading">Φόρτωση...</p>
        </div>
      </div>
      <aside class="summary" id="cart-summary" hidden>
        <h2>Σύνοψη</h2>
        <div class="summary-row">
          <span>Υποσύνολο</span>
          <span id="sum-subtotal">—</span>
        </div>
        <div class="summary-row">
          <span>Μεταφορικά</span>
          <span>Υπολογίζονται στο ταμείο</span>
        </div>
        <div class="summary-total">
          <span>Σύνολο</span>
          <span id="sum-total">—</span>
        </div>
        <a class="shop-btn shop-btn--fill shop-btn--block" href="/shop/checkout">
          Μετάβαση στην πληρωμή
        </a>
        <a
          class="shop-btn shop-btn--line shop-btn--block"
          href="/shop"
          style="margin-top:10px"
        >
          Συνέχεια αγορών
        </a>
      </aside>
    </div>
  </div>

  <script>
    import { shop, formatEuro } from '../../scripts/shop.js';

    const listEl = document.getElementById('cart-list')!;
    const summaryEl = document.getElementById('cart-summary')!;
    const subtotalEl = document.getElementById('sum-subtotal')!;
    const totalEl = document.getElementById('sum-total')!;
    const TONES = ['a', 'b', 'c', 'd', 'e', 'f'];

    function toneFor(key: string) {
      let hash = 0;
      for (let i = 0; i < key.length; i++) hash = (hash * 31 + key.charCodeAt(i)) >>> 0;
      return TONES[hash % TONES.length];
    }

    function render() {
      const items = shop.items;
      if (items.length === 0) {
        summaryEl.hidden = true;
        listEl.innerHTML = `<div class="shop-empty">
          <h2>Το καλάθι είναι άδειο</h2>
          <p>Πρόσθεσε κάποια χειροποίητα κεριά για να συνεχίσεις.</p>
          <a class="shop-btn shop-btn--fill" href="/shop">Δες τη συλλογή</a>
        </div>`;
        return;
      }

      summaryEl.hidden = false;
      listEl.innerHTML = items
        .map((item) => {
          const key = shop.key(item);
          const lineTotal = item.priceCents * item.quantity;
          return `<div class="cart-row" data-key="${key}">
            <div class="cart-thumb tone-${toneFor(item.slug || item.name)}"><span class="pflame"></span></div>
            <div class="cart-info">
              <h3><a href="/shop/${item.slug}" style="color:inherit;text-decoration:none">${item.name}</a></h3>
              <div class="variant">${item.variantName || ''}</div>
              <div class="price">${formatEuro(item.priceCents)} × ${item.quantity} = ${formatEuro(lineTotal)}</div>
              <button type="button" class="cart-remove" data-remove>Αφαίρεση</button>
            </div>
            <div class="shop-qty">
              <button type="button" data-dec aria-label="Μείωση">−</button>
              <input type="number" min="1" value="${item.quantity}" data-qty aria-label="Ποσότητα" />
              <button type="button" data-inc aria-label="Αύξηση">+</button>
            </div>
          </div>`;
        })
        .join('');

      subtotalEl.textContent = formatEuro(shop.subtotalCents());
      totalEl.textContent = formatEuro(shop.subtotalCents());
    }

    listEl.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest('[data-key]') as HTMLElement | null;
      if (!target) return;
      const key = target.dataset.key!;
      const item = shop.items.find((entry) => shop.key(entry) === key);
      if (!item) return;

      if ((event.target as HTMLElement).closest('[data-remove]')) {
        shop.remove(key);
      } else if ((event.target as HTMLElement).closest('[data-dec]')) {
        shop.setQuantity(key, item.quantity - 1);
      } else if ((event.target as HTMLElement).closest('[data-inc]')) {
        shop.setQuantity(key, item.quantity + 1);
      }
    });

    listEl.addEventListener('input', (event) => {
      const input = event.target as HTMLInputElement;
      if (!input.matches('[data-qty]')) return;
      const row = input.closest('[data-key]') as HTMLElement;
      shop.setQuantity(row.dataset.key!, Math.max(1, Number(input.value) || 1));
    });

    window.addEventListener('cart:change', render);
    render();
  </script>
</ShopLayout>
