---
import '../../styles/admin.css';
import { COOKIE_NAME, isValidSession } from '../../lib/auth';
import { SHOP_BRAND } from '../../data/shop';

if (!(await isValidSession(Astro.cookies.get(COOKIE_NAME)?.value))) {
  return Astro.redirect('/admin/login');
}
---

<!DOCTYPE html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>EazyFix Admin — E-shop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="admin">
      <aside class="sidebar">
        <div class="sidebar-brand">
          <span class="mark">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </span>
          <span>E-shop<small>{SHOP_BRAND}</small></span>
        </div>

        <nav class="sidebar-nav" id="shopNav">
          <button type="button" data-tab="orders" class="active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
            <span>Παραγγελίες</span>
          </button>
          <button type="button" data-tab="products">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg>
            <span>Προϊόντα</span>
          </button>
          <button type="button" data-tab="coupons">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 9h.01M15 15h.01M8 8l8 8"/><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/></svg>
            <span>Κουπόνια</span>
          </button>
        </nav>

        <div class="sidebar-foot">
          <a href="/admin">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Πίνακας EazyFix
          </a>
          <a href="/shop" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            Προβολή e-shop
          </a>
          <form method="POST" action="/api/admin/logout">
            <button type="submit">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
              Αποσύνδεση
            </button>
          </form>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <div>
            <h1 id="pageTitle">Φόρτωση...</h1>
            <p id="pageSubtitle"></p>
          </div>
          <div class="topbar-actions">
            <span id="shop-status"></span>
            <span id="shop-actions"></span>
          </div>
        </header>

        <main class="content" id="shop-content">
          <div class="loading">Φόρτωση...</div>
        </main>
      </div>
    </div>

    <script>
      import '../../scripts/admin-shop.js';
    </script>
  </body>
</html>
