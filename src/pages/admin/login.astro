---
import '../../styles/admin.css';
import { COOKIE_NAME, isValidSession } from '../../lib/auth';

if (await isValidSession(Astro.cookies.get(COOKIE_NAME)?.value)) {
  return Astro.redirect('/admin');
}

const hasError = Astro.url.searchParams.has('error');
---

<!DOCTYPE html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Σύνδεση - EazyFix Admin</title>
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=inter:400,500,600,700|sora:600,700,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="login-body">
    <form class="login-card" method="POST" action="/api/admin/login">
      <span class="login-logo">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
        </svg>
      </span>
      <h1>EazyFix Admin</h1>
      <p>Συνδεθείτε για να διαχειριστείτε τη σελίδα.</p>
      {hasError && <div class="login-error">Λάθος κωδικός πρόσβασης. Δοκιμάστε ξανά.</div>}
      <label for="password">Κωδικός πρόσβασης</label>
      <input id="password" name="password" type="password" required autofocus autocomplete="current-password" />
      <button type="submit">Σύνδεση</button>
    </form>
  </body>
</html>
