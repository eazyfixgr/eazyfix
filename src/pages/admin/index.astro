---
import '../../styles/admin.css';
import { COOKIE_NAME, isValidSession } from '../../lib/auth';

if (!(await isValidSession(Astro.cookies.get(COOKIE_NAME)?.value))) {
  return Astro.redirect('/admin/login');
}
---

<!DOCTYPE html>
<html lang="el">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>EazyFix Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="admin">
      <aside class="sidebar">
        <div class="sidebar-brand">
          <span class="mark">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
            </svg>
          </span>
          <span>EazyFix<small>Admin</small></span>
        </div>

        <nav class="sidebar-nav" id="adminNav">
          <button type="button" data-tab="business" class="active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <span>Επιχείρηση</span>
          </button>
          <button type="button" data-tab="projects">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
            <span>Projects</span>
          </button>
          <button type="button" data-tab="content">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg>
            <span>Περιεχόμενο</span>
          </button>
        </nav>

        <div class="sidebar-foot">
          <div class="storage-box">
            <div class="storage-top">
              <span>Χώρος αρχείων</span>
              <span id="storage-text">—</span>
            </div>
            <div class="storage-bar"><span id="storage-fill"></span></div>
          </div>
          <a href="/admin/shop">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            E-shop
          </a>
          <a href="/" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            Προβολή site
          </a>
          <form method="POST" action="/api/admin/logout">
            <button type="submit">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
              Αποσύνδεση
            </button>
          </form>
        </div>
      </aside>

      <div class="main">
        <header class="topbar">
          <div>
            <h1 id="pageTitle">Φόρτωση...</h1>
            <p id="pageSubtitle"></p>
          </div>
          <div class="topbar-actions">
            <span id="save-status"></span>
            <button id="save-btn" class="abtn abtn--primary">Αποθήκευση</button>
          </div>
        </header>

        <main class="content" id="admin-content">
          <div class="loading">Φόρτωση...</div>
        </main>
      </div>
    </div>

    <script>
      import '../../scripts/admin.js';
    </script>
  </body>
</html>
