---
import Icon from './Icon.astro';
import { categories } from '../data/portfolio';
import type { Project } from '../data/projects';

interface Props {
  locale: 'el' | 'en';
  projects: Project[];
}

const { locale, projects } = Astro.props;

const t =
  locale === 'en'
    ? {
        eyebrow: 'What I do',
        title: 'Choose a field, see the work',
        lead: 'Six areas, one person. Click a category to see what I offer and real projects I have built.',
        details: 'Details',
        empty: 'New projects coming soon.',
      }
    : {
        eyebrow: 'Τι κάνω',
        title: 'Διάλεξε τομέα, δες τη δουλειά',
        lead: 'Έξι τομείς, ένας άνθρωπος. Πάτησε μια κατηγορία για να δεις τι προσφέρω και πραγματικά projects που έχω φτιάξει.',
        details: 'Λεπτομέρειες',
        empty: 'Νέα projects έρχονται σύντομα.',
      };

const enabled = projects.filter((project) => project.enabled);
const base = locale === 'en' ? '/en/projects/' : '/projects/';

function linkHref(href: string): string {
  if (locale === 'en' && href === '/templates') return '/en/templates';
  return href;
}
---

<section id="work" class="section">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2 class="h2">{t.title}</h2>
      <p class="lead" style="margin-left:auto;margin-right:auto">{t.lead}</p>
    </div>

    <div class="explorer">
      <div class="tabs" role="tablist">
        {categories.map((category, index) => (
          <button
            type="button"
            class:list={['tab', { active: index === 0 }]}
            data-cat={category.slug}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            <Icon name={category.icon} size={18} />
            <span>{category.title[locale]}</span>
          </button>
        ))}
      </div>

      {categories.map((category, index) => {
        const items = enabled.filter((project) => project.category === category.slug);
        return (
          <div class:list={['panel', { active: index === 0 }]} data-panel={category.slug}>
            <div class="panel-head">
              <div class="panel-title">
                <span class="panel-icon"><Icon name={category.icon} /></span>
                <div>
                  <h3>{category.title[locale]}</h3>
                  <p class="panel-short">{category.short[locale]}</p>
                </div>
              </div>
              <div class="panel-desc">
                <p>{category.description[locale]}</p>
                <div class="chips">
                  {category.tech.map((tech) => (
                    <span class="chip">{tech}</span>
                  ))}
                </div>
              </div>
            </div>

            <ul class="highlights">
              {category.highlights[locale].map((highlight) => (
                <li>
                  <span class="check"><Icon name="check" size={13} /></span>
                  {highlight}
                </li>
              ))}
            </ul>

            {items.length > 0 ? (
              <div class="projects">
                {items.map((project) => (
                  <article class="project">
                    <a class="project-overlay" href={`${base}${project.slug}`} aria-label={project.name} />
                    <div class="project-head">
                      <h4>{project.name}</h4>
                      {project.url && (
                        <a class="project-open" href={project.url} target="_blank" rel="noopener" aria-label={`${project.linkLabel?.[locale] ?? t.details} ${project.name}`}>
                          <Icon name="external-link" size={16} />
                        </a>
                      )}
                    </div>
                    <p>{project.description[locale]}</p>
                    <div class="project-foot">
                      {project.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                      <span class="project-more">
                        {t.details}
                        <Icon name="chevron-right" size={14} />
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p class="empty">{t.empty}</p>
            )}

            {category.extraLink && (
              <a class="panel-cta" href={linkHref(category.extraLink.href)}>
                {category.extraLink.label[locale]}
                <Icon name="arrow-right" size={17} />
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.tab[data-cat]');
  const panels = document.querySelectorAll('.panel[data-panel]');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const slug = tab.getAttribute('data-cat');
      tabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle('active', active);
        item.setAttribute('aria-selected', String(active));
      });
      panels.forEach((panel) => {
        panel.classList.toggle('active', panel.getAttribute('data-panel') === slug);
      });
    });
  });
</script>

<style>
  .explorer {
    margin-top: 8px;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 34px;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 20px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.18s ease, background 0.18s ease, color 0.18s ease,
      transform 0.18s ease;
  }

  .tab:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
  }

  .tab.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  .tab svg {
    flex-shrink: 0;
  }

  .panel {
    display: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 38px;
    box-shadow: var(--shadow-md);
  }

  .panel.active {
    display: block;
    animation: fade 0.28s ease;
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .panel-head {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 40px;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line);
  }

  .panel-title {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .panel-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--primary-50);
    color: var(--primary);
    flex-shrink: 0;
  }

  .panel-icon svg {
    width: 25px;
    height: 25px;
  }

  .panel-title h3 {
    font-family: var(--font-head);
    font-size: 1.4rem;
    margin-bottom: 8px;
  }

  .panel-short {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .panel-desc p {
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .chip {
    font-size: 0.76rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 28px;
    list-style: none;
    margin: 26px 0;
    padding: 0;
  }

  .highlights li {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .check {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--primary-50);
    color: var(--primary);
    flex-shrink: 0;
  }

  .empty {
    color: var(--muted);
    font-style: italic;
    padding: 10px 0;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .project {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    background: var(--bg-soft);
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .project:hover {
    transform: translateY(-4px);
    background: #fff;
    box-shadow: var(--shadow-md);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 12px;
  }

  .project-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .project-head h4 {
    font-family: var(--font-head);
    font-size: 1.03rem;
  }

  .project-open {
    position: relative;
    z-index: 2;
    color: var(--muted);
    flex-shrink: 0;
  }

  .project-open:hover {
    color: var(--primary);
  }

  .project p {
    color: var(--muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .project-foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 4px;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 6px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .project-more {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--primary);
  }

  .panel-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 30px;
    font-weight: 700;
    color: var(--primary);
  }

  .panel-cta:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .panel {
      padding: 26px;
    }

    .panel-head {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .projects {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .highlights,
    .projects {
      grid-template-columns: 1fr;
    }

    .tab span {
      font-size: 0.85rem;
    }
  }
</style>
