---
import Icon from './Icon.astro';

interface Props {
  business: {
    name: string;
    phone: string;
    email: string;
    whatsapp: string;
    address: Record<string, string>;
    hours: Record<string, string>;
  };
  contact: { title: Record<string, string>; subtitle: Record<string, string> };
  locale: 'el' | 'en';
}

const { business, contact, locale } = Astro.props;

const labels =
  locale === 'en'
    ? {
        name: 'Name',
        phone: 'Phone',
        service: 'What do you need?',
        message: 'Message',
        submit: 'Send message',
        choose: 'Select...',
        phoneLabel: 'Phone',
        emailLabel: 'Email',
        areaLabel: 'Area',
        hoursLabel: 'Hours',
        options: [
          { value: 'electronics', label: 'Electronics repair' },
          { value: 'website', label: 'Website development' },
          { value: 'android-app', label: 'Android app' },
          { value: 'android-game', label: 'Android game' },
          { value: 'windows-app', label: 'Windows / Python app' },
          { value: 'other', label: 'Other' },
        ],
      }
    : {
        name: 'Όνομα',
        phone: 'Τηλέφωνο',
        service: 'Τι χρειάζεστε;',
        message: 'Μήνυμα',
        submit: 'Αποστολή',
        choose: 'Επιλέξτε...',
        phoneLabel: 'Τηλέφωνο',
        emailLabel: 'Email',
        areaLabel: 'Περιοχή',
        hoursLabel: 'Ώρες',
        options: [
          { value: 'electronics', label: 'Επισκευή ηλεκτρονικών' },
          { value: 'website', label: 'Κατασκευή ιστοσελίδας' },
          { value: 'android-app', label: 'Εφαρμογή Android' },
          { value: 'android-game', label: 'Παιχνίδι Android' },
          { value: 'windows-app', label: 'Εφαρμογή Windows / Python' },
          { value: 'other', label: 'Άλλο' },
        ],
      };
---

<section id="contact" class="section">
  <div class="container contact-grid">
    <div class="contact-info">
      <div class="section-head" style="margin-bottom:32px">
        <h2 class="h2">{contact.title[locale]}</h2>
        <p class="lead">{contact.subtitle[locale]}</p>
      </div>

      <ul class="info-list">
        <li>
          <span class="info-icon"><Icon name="phone" size={20} /></span>
          <div>
            <small>{labels.phoneLabel}</small>
            <a href={`tel:${business.phone}`}>{business.phone}</a>
          </div>
        </li>
        <li>
          <span class="info-icon"><Icon name="mail" size={20} /></span>
          <div>
            <small>{labels.emailLabel}</small>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </div>
        </li>
        <li>
          <span class="info-icon"><Icon name="map-pin" size={20} /></span>
          <div>
            <small>{labels.areaLabel}</small>
            <span>{business.address[locale]}</span>
          </div>
        </li>
        <li>
          <span class="info-icon"><Icon name="clock" size={20} /></span>
          <div>
            <small>{labels.hoursLabel}</small>
            <span>{business.hours[locale]}</span>
          </div>
        </li>
      </ul>
    </div>

    <form class="contact-form" id="contactForm" data-whatsapp={business.whatsapp} data-locale={locale}>
      <div class="field">
        <label for="name">{labels.name}</label>
        <input type="text" id="name" name="name" required />
      </div>
      <div class="field">
        <label for="phone">{labels.phone}</label>
        <input type="tel" id="phone" name="phone" required />
      </div>
      <div class="field">
        <label for="service">{labels.service}</label>
        <select id="service" name="service" required>
          <option value="">{labels.choose}</option>
          {labels.options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="message">{labels.message}</label>
        <textarea id="message" name="message" rows="4" required></textarea>
      </div>
      <div class="field consent-field">
        <label class="consent-label">
          <input type="checkbox" id="consent" name="consent" required />
          <span>
            {locale === 'en' ? 'I have read and accept the ' : 'Έχω διαβάσει και αποδέχομαι την '}
            <a href={locale === 'en' ? '/en/privacy' : '/privacy'} target="_blank" rel="noopener">
              {locale === 'en' ? 'Privacy Policy' : 'Πολιτική Απορρήτου'}
            </a>
            {locale === 'en'
              ? '. The message will be sent via WhatsApp (Meta).'
              : '. Το μήνυμα θα σταλεί μέσω WhatsApp (Meta).'}
          </span>
        </label>
      </div>
      <p class="form-note">
        {locale === 'en'
          ? 'Pressing send opens WhatsApp with your message pre-filled. Your data is transmitted via WhatsApp (Meta).'
          : 'Πατώντας αποστολή, ανοίγει το WhatsApp με προσυμπληρωμένο το μήνυμα. Τα στοιχεία σας διαβιβάζονται μέσω WhatsApp (Meta).'}
      </p>
      <button type="submit" class="btn btn--primary btn--block">
        {labels.submit}
        <Icon name="arrow-right" size={18} />
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    if (!data.get('consent')) return;
    const locale = form.dataset.locale === 'en' ? 'en' : 'el';
    const whatsapp = form.dataset.whatsapp || '';

    const serviceNames =
      locale === 'en'
        ? {
            electronics: 'Electronics repair',
            website: 'Website development',
            'android-app': 'Android app',
            'android-game': 'Android game',
            'windows-app': 'Windows / Python app',
            other: 'Other',
          }
        : {
            electronics: 'Επισκευή ηλεκτρονικών',
            website: 'Κατασκευή ιστοσελίδας',
            'android-app': 'Εφαρμογή Android',
            'android-game': 'Παιχνίδι Android',
            'windows-app': 'Εφαρμογή Windows / Python',
            other: 'Άλλο',
          };

    const header = locale === 'en' ? 'New request' : 'Νέο αίτημα';
    const labels =
      locale === 'en'
        ? { name: 'Name', phone: 'Phone', service: 'Service', message: 'Message' }
        : { name: 'Όνομα', phone: 'Τηλέφωνο', service: 'Υπηρεσία', message: 'Μήνυμα' };

    const service = String(data.get('service') ?? '');
    const text = `${header}%0A%0A${labels.name}: ${data.get('name')}%0A${labels.phone}: ${data.get('phone')}%0A${labels.service}: ${serviceNames[service] ?? service}%0A${labels.message}: ${data.get('message')}`;
    window.open(`https://wa.me/${whatsapp}?text=${text}`, '_blank');
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .info-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }

  .info-list li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .info-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--primary-50);
    color: var(--primary);
    flex-shrink: 0;
  }

  .info-list small {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 2px;
  }

  .info-list a,
  .info-list span {
    font-weight: 600;
  }

  .info-list a:hover {
    color: var(--primary);
  }

  .contact-form {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px;
    box-shadow: var(--shadow-md);
  }

  .field {
    margin-bottom: 18px;
  }

  .field label {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 7px;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 13px 15px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: 0.97rem;
    font-family: inherit;
    background: #fff;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 4px var(--primary-50);
  }

  .field textarea {
    resize: vertical;
  }

  .consent-field {
    margin-bottom: 14px;
  }

  .consent-label {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 500;
    line-height: 1.5;
  }

  .consent-label input {
    width: auto;
    margin-top: 3px;
    flex-shrink: 0;
  }

  .consent-label a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .form-note {
    margin: 0 0 18px;
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
