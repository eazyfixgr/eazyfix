---
import Icon from './Icon.astro';

interface Props {
  hero: {
    badge: Record<string, string>;
    title: Record<string, string>;
    titleAccent: Record<string, string>;
    subtitle: Record<string, string>;
    primaryCta: Record<string, string>;
    secondaryCta: Record<string, string>;
    stats: { value: string; label: Record<string, string> }[];
  };
  locale: 'el' | 'en';
}

const { hero, locale } = Astro.props;
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <span class="hero-badge">
      <span class="dot"></span>
      {hero.badge[locale]}
    </span>
    <h1 class="hero-title">
      {hero.title[locale]}
      <span class="accent">{hero.titleAccent[locale]}</span>
    </h1>
    <p class="hero-sub">{hero.subtitle[locale]}</p>
    <div class="hero-cta">
      <a href="#work" class="btn btn--primary">{hero.primaryCta[locale]}</a>
      <a href="#contact" class="btn btn--ghost-light">{hero.secondaryCta[locale]}</a>
      <a
        href={locale === 'en' ? '/en/projects/rita-samothraki#pricing' : '/projects/rita-samothraki#pricing'}
        class="btn btn--ghost-light hero-offer"
      >
        <Icon name="tag" size={16} />
        {locale === 'en' ? 'See real estate website pricing' : 'Δείτε το κόστος για μεσιτική ιστοσελίδα'}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <dl class="hero-stats">
      {hero.stats.map((stat) => (
        <div class="stat">
          <dt>{stat.value}</dt>
          <dd>{stat.label[locale]}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding: 96px 0 84px;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    inset: -60% 0 auto 0;
    margin: 0 auto;
    width: 900px;
    height: 700px;
    background: radial-gradient(circle at center, rgba(99, 102, 241, 0.4), transparent 62%);
  }

  .hero-grid-bg {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(148, 163, 184, 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(circle at 50% 30%, #000 0%, transparent 72%);
  }

  .hero-inner {
    position: relative;
    max-width: 1040px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.82rem;
    font-weight: 500;
    color: #dbeafe;
    margin-bottom: 26px;
  }

  .hero-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.18);
  }

  .hero-title {
    color: #fff;
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    line-height: 1.1;
    text-wrap: balance;
    margin-inline: auto;
  }

  .hero-title .accent {
    display: block;
    text-wrap: balance;
    background: linear-gradient(100deg, #a5b4fc, #67e8f9);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-sub {
    margin: 24px auto 0;
    color: #cbd5e1;
    font-size: 1.12rem;
    max-width: 58ch;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 34px;
  }

  .btn--ghost-light {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .btn--ghost-light:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .hero-offer {
    border-color: rgba(103, 232, 249, 0.42);
    background: rgba(103, 232, 249, 0.08);
    color: #e0f2fe;
    gap: 8px;
  }

  .hero-offer:hover {
    background: rgba(103, 232, 249, 0.16);
    border-color: rgba(103, 232, 249, 0.68);
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 56px;
    margin: 56px 0 0;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .stat dt {
    font-family: var(--font-head);
    font-size: 1.7rem;
    font-weight: 800;
    color: #fff;
  }

  .stat dd {
    margin: 4px 0 0;
    color: #94a3b8;
    font-size: 0.86rem;
  }

  @media (max-width: 560px) {
    .hero-stats {
      gap: 28px;
    }
  }
</style>
