---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import type { Business } from '../data/site';

interface Props {
  project?: Project;
  business: Business;
  locale: 'el' | 'en';
}

const { project, business, locale } = Astro.props;
const shot = project?.screenshots?.find(Boolean);
const pricing = project?.pricing;
const plans = pricing?.plans ?? [];
const service = project?.service;

const copy =
  locale === 'en'
    ? {
        title: 'Real estate website development | EazyFix',
        description:
          'Website development for real estate agencies with listing management, smart search, map and enquiry matching. See a real project and pricing.',
        eyebrow: 'For real estate agencies',
        h1: 'A real estate website that runs the office, not just a brochure',
        lead:
          'A complete system for presenting properties, managing listings and organising enquiries — built for your agency and supported after launch.',
        quote: 'Request a quote',
        live: 'Visit the real website',
        demo: 'Try the management demo',
        facts: ['A real project in production', '10 languages', 'Admin panel included'],
        proofEyebrow: 'A real project',
        proofTitle: 'Built for an agency, used every day',
        proofText:
          'The Rita Samothraki website combines property showcases with a management system: listings and photos, smart search, map, favourites, comparison and enquiry matching.',
        proofPoints: [
          'Listings, photos and content managed from the admin panel',
          'Smart search, advanced filters, interactive map and comparison',
          'Enquiry matching and email proposals in 10 languages',
        ],
        proofLink: 'See the project details',
        featuresEyebrow: 'What is included',
        featuresTitle: 'Everything a real estate office needs',
        featuresLead: 'Designed for the daily work of an agency, not only for the homepage.',
        features: [
          ['Listing and photo management', 'Add, edit and organise properties and photos from the admin panel.', 'layout'],
          ['Smart property search', 'Visitors search in natural language, with advanced filters and categories.', 'search'],
          ['Interactive property map', 'Explore available properties on a map and open the ones that fit.', 'map'],
          ['Favourites and comparison', 'Save properties and compare them before contacting the office.', 'heart'],
          ['Enquiry matching', 'Requests are matched to available properties and organised for follow-up.', 'git-compare'],
          ['10 languages and SEO', 'A multilingual presentation with optimised photos and technical SEO.', 'globe'],
        ],
        pricingEyebrow: 'Build pricing',
        pricingTitle: 'Get your own real estate website',
        pricingLead:
          'Two options for building and customising your real estate website, with ongoing maintenance and technical support.',
        setupLabel: 'one-time build',
        monthlyLabel: '/month maintenance',
        includesTitle: 'What the monthly maintenance includes',
        footnote:
          'Prices exclude VAT. Any domain, hosting and third-party charges are clarified in the quote. Additional features and custom requirements are priced separately.',
        transferTitle: 'We also handle transferring your properties',
        processEyebrow: 'How we work',
        processTitle: 'A clear process, from the first call to launch',
        process: [
          ['Discussion and quote', 'We define needs, content and the right package before any work starts.'],
          ['Content and design', 'We organise your properties, texts, photos and the identity of your office.'],
          ['Build and checks', 'The website is built, tested on mobile and desktop, and reviewed with you.'],
          ['Launch and support', 'The site goes live and ongoing support continues with the maintenance plan.'],
        ],
        faqEyebrow: 'Questions',
        faqTitle: 'What agencies usually ask',
        faq: [
          ['How much does it cost?', 'Construction starts at €990 for the first three agencies and €1,490 at the standard price, with €69 or €89 per month maintenance respectively. Prices exclude VAT and the final quote depends on the features you need.'],
          ['How long does it take?', 'It depends on the content, photos and features. The timeline is agreed in the quote before any work starts.'],
          ['Can you transfer our existing listings?', 'Yes, optionally and by arrangement. We can transfer descriptions, features and photos so you do not have to enter everything manually.'],
          ['Does it support Greek and English?', 'Yes. The system supports 10 languages, including Greek and English.'],
          ['Do I need technical knowledge?', 'No. You manage the website from the admin panel, and I provide training and support.'],
        ],
        ctaTitle: 'Want a website like this for your agency?',
        ctaText:
          'Upgrade your agency’s online presence with a specialised property management and showcase system, tailored to your brand.',
        ctaButton: 'Request a quote',
        ctaCall: 'Call',
        ctaEmail: 'Email',
      }
    : {
        title: 'Κατασκευή μεσιτικής ιστοσελίδας | EazyFix',
        description:
          'Κατασκευή ιστοσελίδων για μεσιτικά γραφεία με διαχείριση αγγελιών, έξυπνη αναζήτηση, χάρτη και αντιστοίχιση αιτημάτων. Δείτε πραγματικό έργο και τιμές.',
        eyebrow: 'Για μεσιτικά γραφεία',
        h1: 'Μεσιτική ιστοσελίδα που οργανώνει το γραφείο, όχι μόνο το παρουσιάζει',
        lead:
          'Ένα ολοκληρωμένο σύστημα για την προβολή ακινήτων, τη διαχείριση αγγελιών και την οργάνωση αιτημάτων — στα μέτρα του γραφείου σας, με υποστήριξη μετά την παράδοση.',
        quote: 'Ζητήστε προσφορά',
        live: 'Δείτε το πραγματικό site',
        demo: 'Δοκιμάστε τη διαχείριση',
        facts: ['Πραγματικό έργο σε λειτουργία', '10 γλώσσες', 'Admin panel'],
        proofEyebrow: 'Πραγματικό έργο',
        proofTitle: 'Φτιαγμένο για γραφείο, σε καθημερινή χρήση',
        proofText:
          'Η ιστοσελίδα της Ρίτας Σαμοθράκη συνδυάζει την προβολή ακινήτων με σύστημα διαχείρισης: αγγελίες και φωτογραφίες, έξυπνη αναζήτηση, χάρτη, αγαπημένα, σύγκριση και αντιστοίχιση αιτημάτων.',
        proofPoints: [
          'Αγγελίες, φωτογραφίες και περιεχόμενο από το admin panel',
          'Έξυπνη αναζήτηση, φίλτρα, διαδραστικός χάρτης και σύγκριση',
          'Αντιστοίχιση αιτημάτων και προτάσεις email σε 10 γλώσσες',
        ],
        proofLink: 'Δείτε τις λεπτομέρειες του project',
        featuresEyebrow: 'Τι περιλαμβάνει',
        featuresTitle: 'Όλα όσα χρειάζεται ένα μεσιτικό γραφείο',
        featuresLead: 'Σχεδιασμένο για την καθημερινή εργασία του γραφείου, όχι μόνο για την αρχική σελίδα.',
        features: [
          ['Διαχείριση αγγελιών και φωτογραφιών', 'Προσθήκη, επεξεργασία και οργάνωση ακινήτων και φωτογραφιών από το admin panel.', 'layout'],
          ['Έξυπνη αναζήτηση ακινήτων', 'Ο επισκέπτης αναζητά με φυσική γλώσσα, προηγμένα φίλτρα και κατηγορίες.', 'search'],
          ['Διαδραστικός χάρτης', 'Προβολή των διαθέσιμων ακινήτων στον χάρτη και άνοιγμα όσων ταιριάζουν.', 'map'],
          ['Αγαπημένα και σύγκριση', 'Αποθήκευση ακινήτων και σύγκριση πριν από την επικοινωνία με το γραφείο.', 'heart'],
          ['Αντιστοίχιση αιτημάτων', 'Τα αιτήματα αντιστοιχίζονται με διαθέσιμα ακίνητα και οργανώνονται για follow-up.', 'git-compare'],
          ['10 γλώσσες και SEO', 'Πολυγλωσσική παρουσίαση με βελτιστοποιημένες φωτογραφίες και τεχνική υποδομή SEO.', 'globe'],
        ],
        pricingEyebrow: 'Τιμοκατάλογος κατασκευής',
        pricingTitle: 'Αποκτήστε τη δική σας μεσιτική ιστοσελίδα',
        pricingLead:
          'Δύο επιλογές για την κατασκευή και παραμετροποίηση της μεσιτικής σας ιστοσελίδας, με συνεχή συντήρηση και τεχνική υποστήριξη.',
        setupLabel: 'εφάπαξ κατασκευή',
        monthlyLabel: '/μήνα συντήρηση',
        includesTitle: 'Τι περιλαμβάνει η μηνιαία συντήρηση',
        footnote:
          'Οι τιμές δεν περιλαμβάνουν ΦΠΑ. Τυχόν χρεώσεις domain, φιλοξενίας και υπηρεσιών τρίτων διευκρινίζονται κατά την προσφορά. Πρόσθετες λειτουργίες και εξατομικευμένες απαιτήσεις κοστολογούνται ξεχωριστά.',
        transferTitle: 'Αναλαμβάνουμε και τη μεταφορά των ακινήτων σας',
        processEyebrow: 'Πώς δουλεύουμε',
        processTitle: 'Καθαρή διαδικασία, από το πρώτο τηλέφωνο μέχρι την παράδοση',
        process: [
          ['Συζήτηση και προσφορά', 'Ορίζουμε ανάγκες, περιεχόμενο και το κατάλληλο πακέτο πριν ξεκινήσει οποιαδήποτε εργασία.'],
          ['Περιεχόμενο και σχεδιασμός', 'Οργανώνουμε ακίνητα, κείμενα, φωτογραφίες και την ταυτότητα του γραφείου σας.'],
          ['Κατασκευή και έλεγχοι', 'Η ιστοσελίδα χτίζεται, ελέγχεται σε κινητό και υπολογιστή και τη βλέπουμε μαζί.'],
          ['Παράδοση και υποστήριξη', 'Η σελίδα βγαίνει σε λειτουργία και η υποστήριξη συνεχίζεται με το πρόγραμμα συντήρησης.'],
        ],
        faqEyebrow: 'Απορίες',
        faqTitle: 'Τι ρωτούν συνήθως τα μεσιτικά γραφεία',
        faq: [
          ['Πόσο κοστίζει;', 'Η κατασκευή ξεκινά από 990 € για τα πρώτα 3 μεσιτικά γραφεία και 1.490 € στην κανονική τιμή, με 69 € ή 89 €/μήνα συντήρηση αντίστοιχα. Οι τιμές δεν περιλαμβάνουν ΦΠΑ και η τελική προσφορά εξαρτάται από τις λειτουργίες που χρειάζεστε.'],
          ['Πόσο χρόνο διαρκεί;', 'Εξαρτάται από το περιεχόμενο, τις φωτογραφίες και τις λειτουργίες. Η διάρκεια ορίζεται στην προσφορά πριν ξεκινήσει η εργασία.'],
          ['Μπορείτε να μεταφέρετε τις αγγελίες μου;', 'Ναι, προαιρετικά και κατόπιν συνεννόησης. Αναλαμβάνουμε περιγραφές, χαρακτηριστικά και φωτογραφίες, ώστε να μη χρειάζεται χειροκίνητη καταχώριση.'],
          ['Υποστηρίζει ελληνικά και αγγλικά;', 'Ναι. Το σύστημα υποστηρίζει 10 γλώσσες, μεταξύ των οποίων ελληνικά και αγγλικά.'],
          ['Χρειάζομαι τεχνικές γνώσεις;', 'Όχι. Η διαχείριση γίνεται από το admin panel και αναλαμβάνω την εκπαίδευση και την υποστήριξη.'],
        ],
        ctaTitle: 'Θέλετε μια αντίστοιχη ιστοσελίδα για το μεσιτικό σας γραφείο;',
        ctaText:
          'Αναβαθμίστε την ηλεκτρονική παρουσία του γραφείου σας με ένα εξειδικευμένο σύστημα διαχείρισης και προβολής ακινήτων, προσαρμοσμένο στην επωνυμία σας.',
        ctaButton: 'Ζητήστε προσφορά',
        ctaCall: 'Κλήση',
        ctaEmail: 'Email',
      };

const contactHref = locale === 'en' ? '/en/?service=real-estate#contact' : '/el/?service=real-estate#contact';
const siteHref = project?.url ?? 'https://realestate-samothraki.gr/';
const demoHref = '/demo/rita-admin';
const projectHref = locale === 'en' ? '/en/projects/rita-samothraki' : '/projects/rita-samothraki';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: locale === 'en' ? 'Real estate website development' : 'Κατασκευή μεσιτικής ιστοσελίδας',
  serviceType: locale === 'en' ? 'Website development for real estate agencies' : 'Κατασκευή ιστοσελίδων για μεσιτικά γραφεία',
  description: copy.description,
  url: locale === 'en' ? 'https://eazyfix.gr/en/meisitika' : 'https://eazyfix.gr/meisitika',
  provider: { '@type': 'Organization', name: 'EazyFix', url: 'https://eazyfix.gr' },
  areaServed: { '@type': 'Country', name: 'Greece' },
  offers: plans.map((plan) => ({
    '@type': 'Offer',
    name: plan.name[locale],
    price: plan.setup.replace(/[^\d]/g, ''),
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  })),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const faqLdText = JSON.stringify(faqLd).replace(/</g, '\\u003c');
---

<Layout title={copy.title} description={copy.description} locale={locale} business={business}>
  <section class="landing-hero">
    <div class="landing-glow" aria-hidden="true"></div>
    <div class="container landing-hero-inner">
      <span class="landing-eyebrow">{copy.eyebrow}</span>
      <h1>{copy.h1}</h1>
      <p class="landing-lead">{copy.lead}</p>
      <div class="landing-actions">
        <a class="btn btn--primary" href={contactHref}>{copy.quote}<Icon name="arrow-right" size={17} /></a>
        <a class="btn btn--ghost-light" href={siteHref} target="_blank" rel="noopener">{copy.live}<Icon name="external-link" size={16} /></a>
        <a class="btn btn--ghost-light landing-demo" href={demoHref}>{copy.demo}<Icon name="layout" size={16} /></a>
      </div>
      <ul class="landing-facts">
        {copy.facts.map((fact) => <li><Icon name="check" size={14} />{fact}</li>)}
      </ul>
    </div>
  </section>

  <section class="landing-proof">
    <div class="container proof-grid">
      <div class="proof-visual">
        <div class="proof-frame">
          {shot ? <img src={shot} alt={project?.name ?? 'Real estate website'} /> : <div class="proof-placeholder"><Icon name="building" size={42} /></div>}
        </div>
        <span class="proof-badge"><span></span>{locale === 'en' ? 'Live project' : 'Σε λειτουργία'}</span>
      </div>
      <div class="proof-copy">
        <span class="eyebrow">{copy.proofEyebrow}</span>
        <h2 class="h2">{copy.proofTitle}</h2>
        <p class="lead">{copy.proofText}</p>
        <ul class="proof-points">
          {copy.proofPoints.map((point) => <li><span><Icon name="check" size={13} /></span>{point}</li>)}
        </ul>
        <a class="proof-link" href={projectHref}>{copy.proofLink}<Icon name="arrow-right" size={15} /></a>
      </div>
    </div>
  </section>

  <section class="landing-section" id="features">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.featuresEyebrow}</span>
        <h2 class="h2">{copy.featuresTitle}</h2>
        <p class="lead">{copy.featuresLead}</p>
      </div>
      <div class="landing-features">
        {copy.features.map(([title, text, iconName]) => (
          <article class="landing-feature">
            <span class="feature-icon"><Icon name={iconName} size={21} /></span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {pricing && plans.length > 0 && (
    <section class="landing-section landing-soft" id="pricing">
      <div class="container">
        <div class="section-head">
          {pricing.eyebrow?.[locale] && <span class="eyebrow">{pricing.eyebrow[locale]}</span>}
          <h2 class="h2">{copy.pricingTitle}</h2>
          <p class="lead">{copy.pricingLead}</p>
        </div>
        <div class="landing-pricing">
          {plans.map((plan) => (
            <article class:list={['landing-plan', { 'landing-plan--featured': plan.highlight }]}>
              {plan.badge?.[locale] && <span class="plan-badge">{plan.badge[locale]}</span>}
              <h3>{plan.name[locale]}</h3>
              <div class="plan-price"><strong>{plan.setup}</strong><span>{copy.setupLabel}</span></div>
              <div class="plan-monthly"><strong>{plan.monthly}</strong><span>{copy.monthlyLabel}</span></div>
              {plan.note?.[locale] && <p class="plan-note">{plan.note[locale]}</p>}
            </article>
          ))}
        </div>
        {pricing.includes?.[locale]?.length > 0 && (
          <div class="plan-includes">
            <h3>{copy.includesTitle}</h3>
            <ul>
              {pricing.includes[locale].map((item) => <li><span><Icon name="check" size={13} /></span>{item}</li>)}
            </ul>
          </div>
        )}
        <p class="plan-footnote">{copy.footnote}</p>
      </div>
    </section>
  )}

  {service && (
    <section class="landing-section">
      <div class="container">
        <div class="landing-transfer">
          <span class="transfer-icon"><Icon name="truck" size={27} /></span>
          <div>
            <h2 class="h3">{service.title[locale]}</h2>
            <p>{service.body[locale]}</p>
            <strong>{service.priceLabel[locale]}</strong>
            {service.note && <small>{service.note[locale]}</small>}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="landing-section landing-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.processEyebrow}</span>
        <h2 class="h2">{copy.processTitle}</h2>
      </div>
      <ol class="landing-process">
        {copy.process.map(([title, text], index) => (
          <li>
            <span class="process-number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="landing-section" id="faq">
    <div class="container faq-wrap">
      <div class="section-head">
        <span class="eyebrow">{copy.faqEyebrow}</span>
        <h2 class="h2">{copy.faqTitle}</h2>
      </div>
      <div class="landing-faq">
        {copy.faq.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="landing-cta" id="quote">
    <div class="container landing-cta-inner">
      <div>
        <h2>{copy.ctaTitle}</h2>
        <p>{copy.ctaText}</p>
        <div class="landing-contact">
          <a href={`tel:${business.phone}`}><Icon name="phone" size={16} />{business.phone}</a>
          <a href={`mailto:${business.email}`}><Icon name="mail" size={16} />{business.email}</a>
        </div>
      </div>
      <a class="btn btn--primary" href={contactHref}>{copy.ctaButton}<Icon name="arrow-right" size={17} /></a>
    </div>
  </section>

  <script type="application/ld+json" set:html={jsonLdText} />
  <script type="application/ld+json" set:html={faqLdText} />
</Layout>

<style>
  .landing-hero {
    position: relative;
    overflow: hidden;
    padding: 92px 0 76px;
    background: var(--ink);
    color: #fff;
    text-align: center;
  }

  .landing-glow {
    position: absolute;
    inset: -50% 0 auto 0;
    height: 620px;
    background: radial-gradient(ellipse at center, rgba(99, 102, 241, 0.35), transparent 62%);
  }

  .landing-hero-inner {
    position: relative;
    max-width: 900px;
  }

  .landing-eyebrow {
    color: #a5b4fc;
  }

  .landing-hero h1 {
    margin: 18px auto 0;
    color: #fff;
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 1.12;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .landing-lead {
    margin: 22px auto 0;
    max-width: 62ch;
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .landing-actions {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 11px;
  }

  .btn--ghost-light {
    border-color: rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }

  .btn--ghost-light:hover {
    background: rgba(255, 255, 255, 0.14);
  }

  .landing-demo {
    border-color: rgba(103, 232, 249, 0.4);
    background: rgba(103, 232, 249, 0.08);
    color: #e0f2fe;
  }

  .landing-facts {
    margin: 34px 0 0;
    padding: 22px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 26px;
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #cbd5e1;
    font-size: 0.86rem;
  }

  .landing-facts li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .landing-facts svg {
    color: #67e8f9;
  }

  .landing-proof {
    padding: 80px 0;
    background: var(--bg-soft);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 56px;
    align-items: center;
  }

  .proof-visual {
    position: relative;
  }

  .proof-frame {
    overflow: hidden;
    border: 1px solid #dbe3ec;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 30px 70px -35px rgba(15, 23, 42, 0.4);
    aspect-ratio: 16 / 10.5;
  }

  .proof-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .proof-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--primary);
    background: linear-gradient(150deg, var(--primary-50), #fff);
  }

  .proof-badge {
    position: absolute;
    right: 18px;
    bottom: -15px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid #dce7e1;
    border-radius: 999px;
    background: #fff;
    color: #287a5b;
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: 0 12px 30px -18px rgba(15, 23, 42, 0.5);
  }

  .proof-badge span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34a07a;
    box-shadow: 0 0 0 4px rgba(52, 160, 122, 0.16);
  }

