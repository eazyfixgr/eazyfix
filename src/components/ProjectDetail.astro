---
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import type { Category } from '../data/portfolio';

interface Props {
  project: Project;
  category: Category | undefined;
  locale: 'el' | 'en';
  phone: string;
}

const { project, category, locale, phone } = Astro.props;

const t =
  locale === 'en'
    ? {
        back: 'All projects',
        about: 'About this project',
        features: 'Highlights',
        links: 'Links',
        contact: 'Interested? Get in touch',
        contactCta: 'Contact me',
        call: 'Call',
        gallery: 'Screenshots',
        noShots: 'Screenshots coming soon',
      }
    : {
        back: 'Όλα τα projects',
        about: 'Σχετικά με το project',
        features: 'Βασικά σημεία',
        links: 'Σύνδεσμοι',
        contact: 'Σας ενδιαφέρει; Επικοινωνήστε',
        contactCta: 'Επικοινωνία',
        call: 'Κλήση',
        gallery: 'Screenshots',
        noShots: 'Screenshots σύντομα',
      };

const shots = (project.screenshots ?? []).filter(Boolean);
const shotsJson = JSON.stringify(shots).replace(/</g, '\\u003c');
const body = project.body?.[locale] || project.description[locale];
const features = project.features?.[locale] ?? [];
const categoryTitle = category?.title[locale] ?? '';
const pricing = project.pricing;
const service = project.service;
const cta = project.cta;
const plans = (pricing?.plans ?? []).filter(
  (plan) => Boolean(plan && plan.name && (plan.name[locale] || plan.setup || plan.monthly))
);
const showPricing = Boolean(pricing && pricing.title?.[locale] && plans.length > 0);
const showService = Boolean(service && service.title?.[locale] && service.body?.[locale]);
const showCta = Boolean(cta && cta.title?.[locale] && cta.body?.[locale]);
const hasRich = showPricing || showService || showCta;
const showSidebarFeatures = features.length > 0 && !hasRich;
const fallbackIcons = ['layout', 'search', 'sliders', 'map', 'globe', 'heart', 'file-text', 'git-compare', 'users', 'devices', 'zap', 'wrench'];
const featureIcon = (index: number) => project.featureIcons?.[index] || fallbackIcons[index % fallbackIcons.length];
const contactHref = locale === 'en' ? '/en/#contact' : '/el/#contact';
const resolveHref = (href?: string) => (!href || href === 'contact' ? contactHref : href);

const downloadExt = (project.downloadName ?? project.downloadUrl ?? '').toLowerCase();
const downloadDefault =
  downloadExt.endsWith('.exe')
    ? locale === 'en'
      ? 'Download EXE'
      : 'Λήψη EXE'
    : downloadExt.endsWith('.zip')
      ? locale === 'en'
        ? 'Download ZIP'
        : 'Λήψη ZIP'
      : locale === 'en'
        ? 'Download APK'
        : 'Λήψη APK';
---

<div class="detail-page">
  <div class="container">
    <nav class="crumbs">
      <a href={locale === 'en' ? '/en/' : '/el/'}>{locale === 'en' ? 'Home' : 'Αρχική'}</a>
      <span>/</span>
      <a href={locale === 'en' ? '/en/' : '/el/'}>#work</a>
      <span>/</span>
      <a href={`${locale === 'en' ? '/en/' : '/el/'}#work`}>{categoryTitle}</a>
      <span>/</span>
      <span class="crumb-current">{project.name}</span>
    </nav>

    <div class="detail-grid">
      <div class="gallery">
        <div class="main">
          {shots.length > 0 && (
            <div class="main-bar">
              <span id="shot-counter">1 / {shots.length}</span>
              <span class="main-title">{project.name}</span>
            </div>
          )}
          <div class="main-frame">
            {shots.length > 0 ? (
              <button type="button" id="main-open" class="main-btn" aria-label="Gallery">
                <img id="main-image" src={shots[0]} alt={project.name} />
              </button>
            ) : (
              <div class="placeholder">
                <span class="ph-icon"><Icon name={category?.icon ?? 'image'} size={44} /></span>
                <span class="ph-text">{t.noShots}</span>
              </div>
            )}
            {shots.length > 1 && (
              <>
                <button type="button" id="main-prev" class="nav-arrow nav-arrow--left" aria-label="Previous">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
                </button>
                <button type="button" id="main-next" class="nav-arrow nav-arrow--right" aria-label="Next">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                </button>
              </>
            )}
          </div>
        </div>

        {shots.length > 1 && (
          <div class="thumbs" id="thumbs">
            {shots.map((shot, index) => (
              <button type="button" class:list={['thumb', { active: index === 0 }]} data-thumb={index} aria-label={`Screenshot ${index + 1}`}>
                <img src={shot} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>

      <aside class="info">
        <div class="info-card">
          {category && (
            <span class="cat-pill">
              <Icon name={category.icon} size={15} />
              {categoryTitle}
            </span>
          )}
          <h1>{project.name}</h1>
          <p class="lead">{project.description[locale]}</p>

          <div class="tags">
            {project.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>

          {showSidebarFeatures && (
            <div class="block">
              <h2>{t.features}</h2>
              <ul class="features">
                {features.map((feature) => (
                  <li>
                    <span class="check"><Icon name="check" size={13} /></span>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="actions">
            {project.url && (
              <a class="btn btn--primary btn--block" href={project.url} target="_blank" rel="noopener">
                {project.linkLabel?.[locale] ?? (locale === 'en' ? 'Open' : 'Άνοιγμα')}
                <Icon name="external-link" size={17} />
              </a>
            )}
            {project.downloadUrl && (
              <a class="btn btn--dark btn--block" href={project.downloadUrl} download>
                {project.downloadLabel?.[locale] ?? downloadDefault}
                {project.downloadSize ? ` (${(project.downloadSize / 1048576).toFixed(1)} MB)` : ''}
                <Icon name="hard-drive" size={17} />
              </a>
            )}
            <a class="btn btn--outline btn--block" href={locale === 'en' ? '/en/#contact' : '/#contact'}>
              {t.contactCta}
              <Icon name="arrow-right" size={17} />
            </a>
          </div>

          <a class="back" href={`${locale === 'en' ? '/en/' : '/el/'}#work`}>
            <Icon name="arrow-right" size={15} />
            {t.back}
          </a>
        </div>
      </aside>
    </div>

    {body && (
      <section class="about-wide" id="about">
        <h2>{t.about}</h2>
        <p class="body-text">{body}</p>
      </section>
    )}

    {hasRich && (
      <div class="rich">
        {features.length > 0 && (
          <section class="rich-section" id="features">
            <div class="rich-head">
              <span class="eyebrow">{locale === 'en' ? 'System features' : 'Δυνατότητες συστήματος'}</span>
              <h2 class="rich-title">
                {locale === 'en' ? 'Everything a real estate office needs' : 'Όλα όσα χρειάζεται ένα μεσιτικό γραφείο'}
              </h2>
            </div>
            <div class="feature-grid">
              {features.map((feature, index) => (
                <div class="feature-card">
                  <span class="feature-ico"><Icon name={featureIcon(index)} size={20} /></span>
                  <p>{feature}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        {showPricing && pricing && (
          <section class="rich-section" id="pricing">
            <div class="rich-head">
              {pricing.eyebrow?.[locale] && <span class="eyebrow">{pricing.eyebrow[locale]}</span>}
              <h2 class="rich-title">{pricing.title[locale]}</h2>
              {pricing.lead?.[locale] && <p class="rich-lead">{pricing.lead[locale]}</p>}
            </div>
            <div class="pricing-grid">
              {plans.map((plan) => (
                <div class:list={['price-card', { 'price-card--featured': plan.highlight }]}>
                  {plan.badge?.[locale] && <span class="price-badge">{plan.badge[locale]}</span>}
                  <h3>{plan.name[locale]}</h3>
                  <div class="price-setup">
                    <strong>{plan.setup}</strong>
                    <span>{locale === 'en' ? 'one-time build' : 'εφάπαξ κατασκευή'}</span>
                  </div>
                  <div class="price-monthly">
                    <strong>{plan.monthly}</strong>
                    <span>{locale === 'en' ? '/month maintenance' : '/μήνα συντήρηση'}</span>
                  </div>
                  {plan.note?.[locale] && <p class="price-note">{plan.note[locale]}</p>}
                </div>
              ))}
            </div>
            {pricing.includes?.[locale]?.length > 0 && (
              <div class="price-includes">
                <h3>{locale === 'en' ? 'What the monthly maintenance includes' : 'Τι περιλαμβάνει η μηνιαία συντήρηση'}</h3>
                <ul>
                  {pricing.includes[locale].map((item) => (
                    <li>
                      <span class="check"><Icon name="check" size={13} /></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {pricing.footnote && <p class="price-footnote">{pricing.footnote[locale]}</p>}
          </section>
        )}

        {showService && service && (
          <section class="rich-section service" id="transfer">
            <div class="service-icon"><Icon name="truck" size={26} /></div>
            <div>
              <h2>{service.title[locale]}</h2>
              <p>{service.body[locale]}</p>
              <p class="service-price">{service.priceLabel[locale]}</p>
              {service.note && <p class="service-note">{service.note[locale]}</p>}
            </div>
          </section>
        )}

        {showCta && cta && (
          <section class="rich-cta" id="quote">
            <div>
              <h2>{cta.title[locale]}</h2>
              <p>{cta.body[locale]}</p>
            </div>
            <div class="rich-cta-actions">
              <a class="btn btn--primary" href={cta.primary.href} target="_blank" rel="noopener">
                {cta.primary.label[locale]}
                <Icon name="external-link" size={17} />
              </a>
              {cta.secondary && (
                <a class="btn btn--outline" href={resolveHref(cta.secondary.href)}>
                  {cta.secondary.label[locale]}
                  <Icon name="arrow-right" size={17} />
                </a>
              )}
            </div>
          </section>
        )}
      </div>
    )}
  </div>

  <div class="lightbox" id="lightbox" hidden>
    <div class="lb-backdrop" data-lb-backdrop></div>
    <div class="lb-inner">
      <img id="lb-image" src="" alt="" />
      <button type="button" id="lb-prev" class="lb-arrow lb-arrow--left" aria-label="Previous">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <button type="button" id="lb-next" class="lb-arrow lb-arrow--right" aria-label="Next">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
      </button>
      <button type="button" id="lb-close" class="lb-close" aria-label="Close">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </div>
</div>

<script type="application/json" id="project-shots" set:html={shotsJson}></script>

<script>
  (() => {
    const dataEl = document.getElementById('project-shots');
    if (!dataEl) return;
    let shots: string[] = [];
    try {
      shots = JSON.parse(dataEl.textContent || '[]');
    } catch {
      shots = [];
    }
    if (!Array.isArray(shots) || shots.length === 0) return;

    const mainImage = document.getElementById('main-image') as HTMLImageElement | null;
    const counter = document.getElementById('shot-counter');
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-thumb]'));
    const lightbox = document.getElementById('lightbox');
    const lbImage = document.getElementById('lb-image') as HTMLImageElement | null;

    let mainIndex = 0;
    let lbIndex = 0;

    const setMain = (index: number) => {
      mainIndex = (index + shots.length) % shots.length;
      if (mainImage) mainImage.src = shots[mainIndex];
      if (counter) counter.textContent = `${mainIndex + 1} / ${shots.length}`;
      thumbs.forEach((thumb, i) => thumb.classList.toggle('active', i === mainIndex));
    };

    const openLb = (index: number) => {
      lbIndex = index;
      if (lightbox) lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      renderLb();
    };
    const closeLb = () => {
      if (lightbox) lightbox.hidden = true;
      document.body.style.overflow = '';
      setMain(lbIndex);
    };
    const renderLb = () => {
      if (lbImage) lbImage.src = shots[lbIndex];
    };
    const nextLb = () => {
      lbIndex = (lbIndex + 1) % shots.length;
      renderLb();
    };
    const prevLb = () => {
      lbIndex = (lbIndex - 1 + shots.length) % shots.length;
      renderLb();
    };

    thumbs.forEach((thumb) => thumb.addEventListener('click', () => setMain(Number(thumb.dataset.thumb))));
    document.getElementById('main-prev')?.addEventListener('click', (event) => {
      event.stopPropagation();
      setMain(mainIndex - 1);
    });
    document.getElementById('main-next')?.addEventListener('click', (event) => {
      event.stopPropagation();
      setMain(mainIndex + 1);
    });
    document.getElementById('main-open')?.addEventListener('click', () => openLb(mainIndex));
    document.getElementById('lb-next')?.addEventListener('click', nextLb);
    document.getElementById('lb-prev')?.addEventListener('click', prevLb);
    document.getElementById('lb-close')?.addEventListener('click', closeLb);
    document.querySelector('[data-lb-backdrop]')?.addEventListener('click', closeLb);

    document.addEventListener('keydown', (event) => {
      if (!lightbox || lightbox.hidden) return;
      if (event.key === 'Escape') closeLb();
      else if (event.key === 'ArrowRight') nextLb();
      else if (event.key === 'ArrowLeft') prevLb();
    });

    setMain(0);
  })();
</script>

<style>
  .detail-page {
    padding: 32px 0 96px;
    background: var(--bg-soft);
    min-height: 60vh;
  }

  .detail-page .container {
    max-width: 1320px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 0.86rem;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .crumbs a:hover {
    color: var(--primary);
  }

  .crumb-current {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 30px;
    align-items: start;
  }

  .detail-grid > * {
    min-width: 0;
  }

  /* Gallery */
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .main {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    min-width: 0;
  }

  .main-bar {
    display: grid;
    grid-template-columns: 4rem 1fr 4rem;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--ink);
    color: #fff;
    font-size: 0.85rem;
  }

  .main-bar #shot-counter {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .main-title {
    text-align: center;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .main-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 68vh;
    background: #eef1f6;
    overflow: hidden;
  }

  .main-btn {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .main-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #0b1120;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 12px;
    background: linear-gradient(150deg, var(--primary-50), #fff);
    color: var(--primary);
  }

  .ph-text {
    color: var(--muted);
    font-weight: 600;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
    box-shadow: var(--shadow-md);
  }

  .nav-arrow:hover {
    background: #fff;
  }

  .nav-arrow--left {
    left: 12px;
  }

  .nav-arrow--right {
    right: 12px;
  }

  .thumbs {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 8px;
    min-width: 0;
    max-width: 100%;
    scrollbar-width: thin;
  }

  .thumb {
    flex: 0 0 128px;
    height: 78px;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid transparent;
    background: #e2e8f0;
    padding: 0;
    cursor: pointer;
  }

  .thumb.active {
    border-color: var(--primary);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Info */
  .info-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 32px;
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 96px;
  }

  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--primary-50);
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .info-card h1 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 14px;
  }

  .lead {
    color: var(--muted);
    font-size: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }

  .tag {
    font-size: 0.76rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .block {
    margin-top: 26px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .block h2 {
    font-size: 1rem;
    margin-bottom: 12px;
  }

  .body-text {
    color: var(--ink-soft);
    font-size: 0.96rem;
    white-space: pre-line;
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.94rem;
    font-weight: 500;
  }

  .check {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--primary-50);
    color: var(--primary);
    flex-shrink: 0;
  }

  .actions {
    display: grid;
    gap: 10px;
    margin-top: 26px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .back svg {
    transform: rotate(180deg);
  }

  .back:hover {
    color: var(--primary);
  }

  /* Rich sections */
  .about-wide {
    margin-top: 30px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 34px 40px;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 96px;
  }

  .about-wide h2 {
    font-size: 1.1rem;
    margin-bottom: 12px;
  }

  .about-wide .body-text {
    max-width: 92ch;
  }

  .rich {
    margin-top: 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .rich-section {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 40px;
    box-shadow: var(--shadow-sm);
    scroll-margin-top: 96px;
  }

  .rich-head {
    max-width: 720px;
    margin-bottom: 28px;
  }

  .rich-title {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin-bottom: 10px;
  }

  .rich-lead {
    color: var(--muted);
    font-size: 1rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .feature-card {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg-soft);
  }

  .feature-card p {
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .feature-ico {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--primary-50);
    color: var(--primary);
    flex-shrink: 0;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .price-card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 30px 28px 26px;
    background: var(--bg-soft);
  }

  .price-card--featured {
    border-color: var(--primary);
    background: linear-gradient(180deg, var(--primary-50), #fff 72%);
    box-shadow: 0 14px 34px -20px rgba(79, 70, 229, 0.5);
  }

  .price-badge {
    position: absolute;
    top: -11px;
    left: 24px;
    background: var(--primary);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
