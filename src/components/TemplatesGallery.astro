---
import { templates } from '../data/templates';

interface Props {
  locale: 'el' | 'en';
}

const { locale } = Astro.props;

const copy =
  locale === 'en'
    ? {
        eyebrow: 'Templates',
        title: 'Seven website templates, seven different styles',
        lead: 'Each template is designed from scratch with its own identity. They are being built one by one — open the ones marked as ready to explore a live demo.',
        soon: 'Coming soon',
        view: 'View live demo',
      }
    : {
        eyebrow: 'Πρότυπα',
        title: 'Επτά πρότυπα ιστοσελίδων, επτά διαφορετικά στιλ',
        lead: 'Κάθε πρότυπο σχεδιάζεται από την αρχή με τη δική του ταυτότητα. Χτίζονται ένα-ένα — άνοιξε όποιο είναι έτοιμο για να δεις ζωντανό demo.',
        soon: 'Σύντομα κοντά σας',
        view: 'Δείτε το demo',
      };
---

<section class="page-hero">
  <div class="page-hero-glow" aria-hidden="true"></div>
  <div class="container">
    <span class="eyebrow eyebrow--light">{copy.eyebrow}</span>
    <h1 class="page-title">{copy.title}</h1>
    <p class="page-lead">{copy.lead}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="gallery-grid">
      {templates.map((template) => {
        const href = template.built ? `/demo/${template.slug}?from=${locale}` : null;
        return (
          <article class:list={['tcard', { 'tcard--live': template.built }]}>
            {href && <a class="tcard-overlay" href={href} aria-label={template.name[locale]} />}
            <div class="tcard-top">
              <span class="tcard-num">{String(template.number).padStart(2, '0')}</span>
              <span class="tcard-cat">{template.category[locale]}</span>
            </div>
            <div class="tcard-body">
              <h3>{template.name[locale]}</h3>
              <p>{template.short[locale]}</p>
            </div>
            {template.built ? (
              <span class="tcard-live">
                {copy.view}
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            ) : (
              <span class="tcard-soon">
                <span class="dot" />
                {copy.soon}
              </span>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: #fff;
    padding: 84px 0 72px;
  }

  .page-hero-glow {
    position: absolute;
    inset: -40% -10% auto auto;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle at center, rgba(99, 102, 241, 0.4), transparent 62%);
  }

  .page-hero .container {
    position: relative;
    max-width: 820px;
  }

  .page-title {
    color: #fff;
    font-size: clamp(2rem, 4.4vw, 3rem);
  }

  .page-lead {
    color: #cbd5e1;
    font-size: 1.1rem;
    margin-top: 20px;
    max-width: 62ch;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .tcard {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .tcard::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), #22d3ee);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .tcard:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-md);
    border-color: transparent;
  }

  .tcard:hover::before {
    opacity: 1;
  }

  .tcard-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .tcard-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .tcard-num {
    font-family: var(--font-head);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--line);
    line-height: 1;
  }

  .tcard-cat {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--primary);
    background: var(--primary-50);
    padding: 5px 12px;
    border-radius: 999px;
  }

  .tcard-body h3 {
    font-family: var(--font-head);
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  .tcard-body p {
    color: var(--muted);
    font-size: 0.93rem;
  }

  .tcard-soon,
  .tcard-live {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .tcard-soon {
    color: var(--muted);
  }

  .tcard-soon .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.15);
  }

  .tcard-live {
    color: var(--primary);
  }

  .tcard--live:hover .tcard-live {
    text-decoration: underline;
  }

  @media (max-width: 980px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
