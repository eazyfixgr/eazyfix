<style is:global>

    :root{--cream:#f7f4ed;--paper:#fffdf8;--sand:#eee7da;--ink:#272522;--muted:#746e66;--red:#802d30;--red2:#5c2025;--wine:#3f2223;--gold:#c49a66;--line:#e5ddd1;--shadow:0 24px 60px rgba(48,29,25,.09);--radius:12px;--ease:cubic-bezier(.2,.7,.2,1)}
    *,*::before,*::after{box-sizing:border-box}
    html{scroll-behavior:smooth;scroll-padding-top:105px}
    body{margin:0;background:var(--cream);font-family:'Manrope',Arial,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased}
    body.menu-open{overflow:hidden}
    a{text-decoration:none;color:inherit}
    button{font:inherit;cursor:pointer}
    img{display:block;width:100%;font-size:0;color:transparent}
    svg{display:block;flex-shrink:0}
    ::selection{background:#dfb4a4;color:#301d1b}
    .container{width:min(100% - 80px,1200px);margin-inline:auto}
    .section{padding:114px 0}
    .section-head{display:flex;align-items:end;justify-content:space-between;gap:26px;margin-bottom:37px}
    .section-title{font-family:'Noto Serif',Georgia,serif;font-size:clamp(32px,4vw,54px);font-weight:500;letter-spacing:-.055em;line-height:1.21;margin:9px 0 0}
    .section-title em{color:var(--red);font-weight:400}
    .eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11px;font-weight:800;letter-spacing:.22em;text-transform:uppercase;color:var(--red)}
    .eyebrow::before{content:"";width:24px;height:1px;background:currentColor}
    .section-intro{max-width:420px;color:var(--muted);line-height:1.9;font-size:14px;margin:0 0 4px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:13px;min-height:56px;padding:0 24px;border-radius:4px;border:1px solid transparent;font-size:12px;font-weight:800;letter-spacing:.04em;white-space:nowrap;transition:transform .22s var(--ease),background .22s,box-shadow .22s}
    .btn svg{width:18px;height:18px}
    .btn:hover{transform:translateY(-2px)}
    .btn-primary{background:var(--red);color:#fff;box-shadow:0 12px 24px rgba(128,45,48,.14)}
    .btn-primary:hover{background:var(--red2);box-shadow:0 16px 26px rgba(128,45,48,.18)}
    .btn-light{background:#fff;color:var(--wine)}
    .btn-outline{background:transparent;color:var(--ink);border-color:#bcb1a4}
    .btn-outline:hover{background:rgba(128,45,48,.05)}
    .text-link{display:inline-flex;gap:12px;align-items:center;color:var(--red);font-size:12px;font-weight:800;letter-spacing:.03em;transition:gap .2s}
    .text-link:hover{gap:18px}
    .text-link svg{width:19px;height:19px}
